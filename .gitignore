# ---------------------------------------------------------------- Node
node_modules/
.pnp
.pnp.js

# ------------------------------------------------------- build output
/dist/
*.tsbuildinfo

# -------------------------------------------------------------- Python
#
# Every pattern below is anchored to the repository root with a leading
# slash, and that is deliberate. A bare `lib/` in gitignore matches a
# directory of that name at ANY depth — so it was silently ignoring
# `src/lib/`, and five files of application code (numerals.ts, format
# helpers, the content lookup) existed only on one laptop, tracked
# nowhere. A fresh clone did not build, and nothing said why.
#
# Anchor these. They describe Python packaging output at the root, not
# any folder that happens to share the name.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/env/
/venv/
/ENV/
/.venv/
/build/
/develop-eggs/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg

# --------------------------------------------------------------- logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------- secrets and env
.env
.env.local
.env.*.local

# --------------------------------------------- local auth data store
api/data/

# ------------------------------------------------------------- deploy
.vercel

# ------------------------------------------------------- IDEs and OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# --------------------------------------------- local tooling only
.claude/
